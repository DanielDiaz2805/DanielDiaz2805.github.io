# Copia este archivo como .env.local y completa los valores.

# ID del formulario de Formspree (https://formspree.io) — ejemplo: xyzabcd
# Si lo dejas vacío, el formulario abrirá el cliente de correo del visitante.
NEXT_PUBLIC_FORMSPREE_ID=

# URL pública final del sitio (para SEO, sitemap y Open Graph), sin barra final.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Solo si publicas en usuario.github.io/nombre-repo (el workflow lo pone solo).
NEXT_PUBLIC_BASE_PATH=
